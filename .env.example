# Cadastro gratuito: enviar e-mail para transparency@entsoe.eu
# com assunto "RESTful API access".
ENTSOE_API_TOKEN=

# Zona(s) de bidding a ingerir, separadas por vírgula. Fase 1: só DE.
ZONES=DE
